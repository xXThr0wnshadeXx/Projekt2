#!/usr/bin/env bash
# Keeps commit messages to a description of the change.
#
# Attribution trailers and "generated with ..." footers are stripped
# automatically. A Co-Authored-By line is kept only if it names someone on the
# team; anything else blocks the commit so you can reword it.
#
# Install once per clone:  bash scripts/install-hooks.sh
set -u

MSG_FILE="$1"
[ -f "$MSG_FILE" ] || exit 0

# People who may legitimately appear as a co-author. Add real teammates here.
TEAM_EMAILS='sshreev2703@gmail[.]com|users[.]noreply[.]github[.]com'

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

# 1. Drop machine-generated footers and any co-author who is not on the team.
awk -v team="$TEAM_EMAILS" '
  BEGIN { IGNORECASE = 1 }
  /^[[:space:]]*co-authored-by:/ {
    if ($0 ~ team) { print; next } else { next }
  }
  /^[[:space:]]*(generated|written|authored|created|produced|assisted)[[:space:]]+(with|by|using)[[:space:]]/ { next }
  /^[[:space:]]*(assisted|generated)-by:/ { next }
  /^[[:space:]]*(tool|agent|model|assistant):[[:space:]]/ { next }
  /^[[:space:]]*🤖/ { next }
  { print }
' "$MSG_FILE" > "$TMP"

# 2. Trim blank lines left behind by the strip.
awk '{ lines[NR] = $0 }
     END { last = NR
           while (last > 0 && lines[last] ~ /^[[:space:]]*$/) last--
           for (i = 1; i <= last; i++) print lines[i] }' "$TMP" > "$MSG_FILE"

# 3. A remaining co-author who is not on the team means someone wrote it inline.
LEFT="$(grep -inE '^[[:space:]]*co-authored-by:' "$MSG_FILE" \
        | grep -ivE "$TEAM_EMAILS" || true)"
if [ -n "$LEFT" ]; then
  echo "commit-msg: unrecognised co-author:" >&2
  echo "$LEFT" >&2
  echo "Remove it, or add the address to TEAM_EMAILS in .githooks/commit-msg." >&2
  exit 1
fi

# 4. Refuse an empty message.
if ! grep -qE '[^[:space:]#]' "$MSG_FILE"; then
  echo "commit-msg: nothing left but attribution lines — describe the change." >&2
  exit 1
fi

exit 0
