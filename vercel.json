{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "glance-api": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "buildCommand": "pip install -r requirements.txt"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "VITE_API_BASE=/ npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "glance-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
