# Copy to backend/.env and fill in. Never commit the real .env.

# Key is server-side only. Never expose it to the front end.
OPENAI_API_KEY=your-key-here

# Every recognition and vision job goes to OpenAI with the one key above; nothing
# is analysed on the device. Model IDs (issues #4, #242). Confirm each exists on
# the account. Recommended:
#   MODEL_VISION=gpt-4.1       Reads worksheets and handwriting into LaTeX
#                              (/api/capture) and checks camera framing
#                              (/api/frame). Strong image understanding and strict
#                              JSON-schema output. For a cheaper, faster framing
#                              check, gpt-4.1-mini is an option, but capture
#                              accuracy matters more, so keep gpt-4.1 if unsure.
#   MODEL_TEXT=gpt-4.1-mini    Spoken maths to LaTeX, voice commands and step
#                              explanations. Text only, and it must answer within
#                              the 4 s spoken-line budget, so a small fast model.
#   MODEL_STT=gpt-4o-transcribe  Speech to text. Best accuracy on spoken numbers
#                              and maths terms; gpt-4o-mini-transcribe is cheaper.
MODEL_VISION=gpt-4.1
MODEL_TEXT=gpt-4.1-mini
MODEL_STT=gpt-4o-transcribe

# CORS: the deployed front-end origin only, no wildcard
ALLOWED_ORIGIN=http://localhost:5173

# Limits (DESIGN.md 16)
MAX_IMAGE_BYTES=8388608
MAX_AUDIO_SECONDS=30
CAS_TIMEOUT_SECONDS=2

# Enables GET /api/stats (live latency/error/cost summary). Header: X-Stats-Token
STATS_TOKEN=

# Per-model prices for cost logging only (USD). Copy current numbers from the
# provider's pricing page for the exact IDs above. Leave empty to log tokens only.
# Example shape: {"<MODEL_TEXT id>": {"input_per_1m": 0, "output_per_1m": 0}, "<MODEL_STT id>": {"per_minute": 0}}
MODEL_PRICES=

# Per-IP request budgets (requests per minute)
RATE_LIMIT_MODEL_PER_MINUTE=20
RATE_LIMIT_PER_MINUTE=120
# Camera framing checks (/api/frame), about one a second while aiming the phone.
# Each one is also a model call, so they count toward MODEL_CALL_LIMIT below.
RATE_LIMIT_FRAME_PER_MINUTE=60
# Shared upstream model-call budget for a single server process. 0 disables it.
# Restarts reset it. Multiple processes or replicas need a shared counter.
MODEL_CALL_LIMIT=0
MODEL_CALL_WINDOW_SECONDS=3600
# Proxies in front of the app that append to X-Forwarded-For. 0 locally, 1 on Render.
TRUSTED_PROXY_HOPS=0
