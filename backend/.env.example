# Copy to backend/.env and fill in. Never commit the real .env.

# Key is server-side only. Never expose it to the front end.
OPENAI_API_KEY=your-key-here

# Model IDs — confirm these exist on the account (issue #4)
MODEL_VISION=
MODEL_TEXT=
MODEL_STT=

# CORS: the deployed front-end origin only, no wildcard
ALLOWED_ORIGIN=http://localhost:5173

# Limits (DESIGN.md 16)
MAX_IMAGE_BYTES=8388608
MAX_AUDIO_SECONDS=30
CAS_TIMEOUT_SECONDS=2
