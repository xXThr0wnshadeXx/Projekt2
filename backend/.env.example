# Copy to backend/.env and fill in. Never commit the real .env.

# Key is server-side only. Never expose it to the front end.
OPENAI_API_KEY=your-key-here

# Model IDs — confirm these exist on the account (issue #4)
MODEL_VISION=
MODEL_TEXT=
MODEL_STT=
# Optional: neural voice for the app's own speech (#182), e.g. a text-to-speech model ID.
# Leave empty to use the browser's built-in voice.
MODEL_TTS=

# CORS: the deployed front-end origin only, no wildcard
ALLOWED_ORIGIN=http://localhost:5173

# Limits (DESIGN.md 16)
MAX_IMAGE_BYTES=8388608
MAX_AUDIO_SECONDS=30
CAS_TIMEOUT_SECONDS=2

# Enables GET /api/stats (live latency/error/cost summary). Header: X-Stats-Token
STATS_TOKEN=

# Per-model prices for cost logging only (USD). Copy current numbers from the
# provider's pricing page for the exact IDs above. Leave empty to log tokens only.
# Example shape: {"<MODEL_TEXT id>": {"input_per_1m": 0, "output_per_1m": 0}, "<MODEL_STT id>": {"per_minute": 0}}
MODEL_PRICES=

# Per-IP request budgets (requests per minute)
RATE_LIMIT_MODEL_PER_MINUTE=20
RATE_LIMIT_PER_MINUTE=120
# Shared upstream model-call budget for a single server process. 0 disables it.
# Restarts reset it. Multiple processes or replicas need a shared counter.
MODEL_CALL_LIMIT=0
MODEL_CALL_WINDOW_SECONDS=3600
# Proxies in front of the app that append to X-Forwarded-For. 0 locally, 1 on Render.
TRUSTED_PROXY_HOPS=0
