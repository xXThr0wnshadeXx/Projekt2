# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Node
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Research material — may contain participant information
docs/evidence/
eval/photos/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Keep the folders, not their contents
!eval/photos/.gitkeep
!docs/evidence/.gitkeep

# Front-end build output and local env
frontend/dist/
frontend/.env.local
# Local editor and tooling folders
.claude/
.vscode/
.idea/
